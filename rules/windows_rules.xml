<!--
  windows_rules.xml
  Owner: ali devjiani (adevjiani)
  Rule ID range: 100200-100299
  Sources: Windows Security channel, Sysmon operational log, Powershell operational log
  Written from: alerts observed in the dashboard Discover tab, plus the Wazuh docs

  Deploy: copy to /var/ossec/etc/rules/ on wazuh-siem-manager,
  chown wazuh:wazuh, wazuh-analysisd -t, restart wazuh-manager.
-->
<group name="local,windows,sysmon,">
  <rule id="100200" level="10" frequency="6" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Multiple failed Windows logons on $(win.eventdata.targetUserName) in short timeframe</description>
    <group>authentication_failures, windows_logon_failures</group>
  </rule>

  <rule id="100201" level="9">
    <if_sid>60009</if_sid>
    <field name="win.eventdata.payload" type="pcre2">(?i)CommandInvocation</field>
    <field name="win.system.message" type="pcre2">(?i)EncodedCommand|FromBase64String|EncodedArguments|-e\b|-enco\b|-en\b</field>
    <description>Encoded command executed via PowerShell.</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <rule id="100202" level="12">
    <if_sid>60154</if_sid>
    <field name="win.system.eventID">^4732$</field>
    <description>Privilege Escalation: User $(win.eventdata.memberName) added to the Windows Administrators group by $(win.eventdata.subjectUserName).</description>
    <group>win_privilege_escalation</group>
  </rule>

<!-- future ip matching consideration -->
<!--risk of high false-->
  <rule id="100203" level="13" timeframe="300">
    <if_sid>60106</if_sid>
    <if_matched_sid>100200</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Successful Windows logon for $(win.eventdata.targetUserName) after multiple failed attempts - possible account compromise through brute force</description>
    <group>authentication_failures, windows_logon_failures, account_compromise</group>
  </rule>

</group>